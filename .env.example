MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/sistem_ganjaran?retryWrites=true&w=majority
PORT=3000

# ===== GOOGLE CLOUD STORAGE (untuk simpan gambar) =====
# Nama bucket yang cikgu cipta dalam Google Cloud Storage
GCS_BUCKET_NAME=ganjaran-bm-gambar

# Isi PENUH kandungan fail JSON service account (buka fail JSON dalam text editor,
# copy semua isi, dan tampal sebagai SATU BARIS di sini - guna dalam Render Environment Variables)
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

